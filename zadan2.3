def is_leap_year(year: int) -> bool:
    """
    Возвращает True, если год високосный, иначе False.
    Правило:
      - делится на 4 → кандидат,
      - но если делится на 100 → не високосный,
      - кроме случаев, когда делится на 400 → високосный.
    """
    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)

# Примеры
print(is_leap_year(2000))  # True (делится на 400)
print(is_leap_year(1900))  # False (делится на 100, но не на 400)
print(is_leap_year(2024))  # True
print(is_leap_year(2023))  # False
